{
  "datasets": [
    {
      "name": "ds_sales",
      "displayName": "Vendas diarias por franquia",
      "queryLines": [
        "SELECT transaction_date, franchise_id, franchise_name, city, country,\n",
        "       orders, unique_customers, units_sold, revenue\n",
        "FROM daily_sales_by_franchise\n",
        "ORDER BY transaction_date\n"
      ],
      "columns": [
        {
          "displayName": "Receita",
          "description": "Receita total no periodo",
          "expression": "SUM(`revenue`)"
        },
        {
          "displayName": "Pedidos",
          "description": "Numero de pedidos",
          "expression": "SUM(`orders`)"
        },
        {
          "displayName": "Ticket Medio",
          "description": "Receita dividida por pedidos",
          "expression": "SUM(`revenue`) / SUM(`orders`)"
        },
        {
          "displayName": "Franquias Ativas",
          "description": "Franquias com vendas no periodo",
          "expression": "COUNT(DISTINCT `franchise_id`)"
        }
      ]
    },
    {
      "name": "ds_products",
      "displayName": "Vendas por produto e pagamento",
      "queryLines": [
        "SELECT product, payment_method, orders, units_sold, revenue, avg_unit_price\n",
        "FROM sales_by_product\n",
        "ORDER BY revenue DESC\n"
      ]
    },
    {
      "name": "ds_franchises",
      "displayName": "Desempenho por franquia",
      "queryLines": [
        "SELECT franchise_name, city, country, latitude, longitude,\n",
        "       revenue, orders, units_sold, avg_ticket, unique_customers, revenue_rank\n",
        "FROM franchise_performance\n",
        "ORDER BY revenue DESC\n"
      ]
    },
    {
      "name": "ds_top_franchises",
      "displayName": "Top 10 franquias",
      "queryLines": [
        "SELECT franchise_name, city, country, revenue, orders, avg_ticket\n",
        "FROM franchise_performance\n",
        "ORDER BY revenue DESC\n",
        "LIMIT 10\n"
      ]
    },
    {
      "name": "ds_sentiment",
      "displayName": "Sentimento por franquia",
      "queryLines": [
        "SELECT franchise_name, city, country, reviews,\n",
        "       positive_reviews, negative_reviews, mixed_reviews,\n",
        "       positive_pct, net_sentiment_score\n",
        "FROM sentiment_by_franchise\n",
        "ORDER BY net_sentiment_score DESC\n"
      ]
    },
    {
      "name": "ds_sentiment_mix",
      "displayName": "Mix de sentimento",
      "queryLines": [
        "SELECT franchise_name, city, country, sentiment, sentiment_reviews\n",
        "FROM sentiment_by_franchise\n",
        "LATERAL VIEW stack(3, 'Positivo', positive_reviews,\n",
        "                      'Misto',    mixed_reviews,\n",
        "                      'Negativo', negative_reviews) t AS sentiment, sentiment_reviews\n",
        "ORDER BY country, sentiment\n"
      ]
    }
  ],
